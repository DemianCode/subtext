{
  "manifest_version": 3,
  "name": "Subtext — Instant Dictionary & Encyclopedia HUD",
  "short_name": "Subtext",
  "version": "1.2.0",
  "description": "Desktop browser reading companion for instant inline dictionary definitions (sub-millisecond local lookup), word pronunciation audio, persistent page annotations, and interactive side-panel encyclopedia lookup.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://api.dictionaryapi.dev/*",
    "https://en.wikipedia.org/*"
  ],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/utils/local_dictionary.js",
        "src/utils/api.js",
        "src/content/content.js"
      ],
      "css": ["src/content/content.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "options_page": "src/options/options.html",
  "commands": {
    "define-selection": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "MacCtrl+Shift+D"
      },
      "description": "Define selected text"
    },
    "explore-selection": {
      "suggested_key": {
        "default": "Alt+Shift+E",
        "mac": "MacCtrl+Shift+E"
      },
      "description": "Explore article for selected text"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/content.css",
        "src/utils/local_dictionary.js",
        "src/utils/api.js",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
